    "/api/Wallet/NewWallet": {
      "post": {
        "tags": [
          "Wallet"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWalletDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWalletDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWalletDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Wallet/deposit": {
      "post": {
        "tags": [
          "Wallet"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositMoneyDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositMoneyDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DepositMoneyDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
