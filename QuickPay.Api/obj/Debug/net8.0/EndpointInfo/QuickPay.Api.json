{
  "openapi": "3.0.1",
  "info": {
    "title": "QuickPay.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Transfer/send": {
      "post": {
        "tags": [
          "Transfer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferMoneyDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferMoneyDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TransferMoneyDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Transfer/history/{userId}": {
      "get": {
        "tags": [
